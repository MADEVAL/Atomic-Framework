{
  "name": "globus-studio/atomic-monorepo",
  "description": "Atomic Framework monorepo — development environment",
  "type": "project",
  "private": true,
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-session": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "globus-studio/atomic-framework": "@dev",
    "globus-studio/atomic-framework-application": "@dev"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/framework",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/skeleton",
      "options": {
        "symlink": true
      }
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Integration\\": "tests/Integration/",
      "Tests\\": "packages/framework/tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "test-fw": "phpunit -c packages/framework/phpunit.xml.dist",
    "test-integration": "phpunit --testsuite Integration"
  }
}
