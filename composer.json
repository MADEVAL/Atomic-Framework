{
  "name": "globus-studio/atomic-framework",
  "description": "Atomic Framework – power in minimalism",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-session": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "globus-studio/fatfree-core": "^3.9.2.1",
    "globus-studio/cortex-atomic": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/skeleton",
      "options": {
        "symlink": true
      }
    }
  ],
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Engine\\Atomic\\": "engine/Atomic/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Tests\\Integration\\": "tests/Integration/"
    }
  },
  "config": {
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "test-fw": "phpunit --testsuite Framework",
    "test-integration": "phpunit --testsuite Integration"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  }
}
