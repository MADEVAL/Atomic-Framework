# Application
APP_NAME=Atomic
APP_KEY=
APP_UUID=
APP_ENCRYPTION_KEY=
DOMAIN=localhost:8000
TZ=UTC
THEME=default

# Locale settings
ENCODING=UTF-8
LANGUAGE=en
I18N_LANGUAGES=en,ru
I18N_DEFAULT=en
I18N_URL_MODE=prefix
I18N_TTL=0
I18N_COOKIE=lang
I18N_SESSION=lang

# Database settings
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DB=atomic
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci
DB_PREFIX=atomic_

# Mail settings
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Atomic

# Telegram Bot settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cache settings
CACHE_DRIVER=folder
CACHE_PATH=storage/framework/cache/
CACHE_SERVER=localhost
CACHE_PASSWORD=
CACHE_LOGIN=
CACHE_PREFIX=atomic.

# Session & Cookie settings
SESSION_DRIVER=db
SESSION_LIFETIME=259200
SESSION_COOKIE=Atomic_Session
SESSION_KILL_ON_SUSPECT=true
SESSION_REDIS_PREFIX=atomic.session.

COOKIE_EXPIRE=259200
COOKIE_PATH=/
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=Lax

# CORS settings
CORS_HEADERS=Content-Type,Authorization
CORS_ORIGIN=*
CORS_CREDENTIALS=false
CORS_EXPOSE=Authorization
CORS_TTL=86400

# Security headers
SECURITY_HEADERS_ENABLED=true
SECURITY_HEADERS_XFO=DENY
SECURITY_HEADERS_HSTS=
SECURITY_HEADERS_CSP=

# Debug settings
DEBUG_MODE=false
DEBUG_LEVEL=error

# Paths
UI=public/themes/
TEMP=storage/framework/cache/data/
LOGS=storage/logs/
FONTS=storage/framework/fonts/
FONTS_TEMP=storage/framework/cache/fonts/
MIGRATIONS=database/migrations/
LOCALES=engine/Atomic/Lang/locales/
USER_PLUGINS=plugins/
SEEDS=database/seeds/
MIGRATIONS_CORE=Atomic/Core/Database/Migrations/
FRAMEWORK_ROUTES=Atomic/Core/Routes/

# Redis settings (optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=atomic.

# Memcached settings (optional)
MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=
MEMCACHED_PREFIX=atomic.

# Queue settings
QUEUE_DRIVER=redis
QUEUE_NAME=default

# Mutex settings
MUTEX_DRIVER=redis

# AI settings (optional)
AI_OPENAI_API_KEY=
AI_GROQ_API_KEY=
AI_OPENROUTER_API_KEY=
AI_GLOBUS_API_KEY=
